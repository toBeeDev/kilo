# 2주차(식단 로그)부터 필요. 1주차 계산기는 환경변수 없이 동작.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버(route handler)에서만 사용. 클라이언트에 절대 노출 금지.
# 둘 중 하나만 있으면 됨. GOOGLE_API_KEY가 있으면 Gemini(기본 gemini-2.5-flash), 없으면 Anthropic.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# 모델 덮어쓰기 (선택). 예: gemini-2.5-flash-lite / claude-haiku-5-5
# AI_MODEL=
# --- API 상한 (선택, 기본값으로 충분) ---
# 브라우저별 일일 한도. 사진 분석(식단+인바디) / 총평 / 식약처 검색
# AI_DAILY_PHOTO_LIMIT=20
# AI_DAILY_SUMMARY_LIMIT=3
# FOOD_DAILY_LIMIT=100
# 사용량 쿠키 서명 키. 비우면 AI 키에서 파생. 운영에선 아무 긴 문자열이나 넣어 두면 키 교체해도 쿠키가 안 깨짐.
# AI_LIMIT_SECRET=
# Supabase를 켜면 AI 호출은 로그인 사용자만. 게스트도 허용하려면 1.
# AI_ALLOW_GUEST=0
# 식약처 식품영양성분DB (공공데이터포털, 디코딩 키). 없으면 AI 추정값만.
MFDS_API_KEY=
# 배포 주소 (SEO canonical/OG 용). 비우면 Vercel 도메인 → 로컬 순으로 추정.
NEXT_PUBLIC_SITE_URL=
